# Supabase の接続情報（Supabase ダッシュボード → Project Settings → API）
#
# ・ローカル開発: このファイルを .env.local にコピーして値を記入
# ・Vercel: 下記2つを Vercel の Project → Settings → Environment Variables に登録
#   （ローカルの .env.local は不要）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
